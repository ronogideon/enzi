// Enzi Packaging — commerce platform schema
// Postgres + Prisma. New DB, so standard `prisma db push` flow (matches Kodee).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  SUPPORT
}

enum PricingTier {
  RETAIL
  WHOLESALE
}

enum OrderStatus {
  DRAFT // in cart / not yet placed
  PENDING_PAYMENT // placed, awaiting STK confirmation (non-POD methods)
  CONFIRMED // paid OR placed on a POD method — ready to work
  PROCESSING
  PACKED
  DISPATCHED
  DELIVERED
  RETURNED // came back to us; stock restored
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MPESA // Daraja STK push
  KOPOKOPO
  CASH
  ON_DELIVERY // placeholder record for pay-on-delivery orders
}

enum DeliveryType {
  STORE_PICKUP
  DELIVERY
  PARCEL // via Matatu — independent cost, POD never allowed
  PICKUP_MTAANI // POD never allowed
}

enum PromoType {
  PERCENT // e.g. 10% off
  FIXED_PRICE // override unit price to a flat value
  FIXED_DISCOUNT // subtract a flat amount per unit
}

enum StockReason {
  RESTOCK
  SALE
  AUDIT_ADJUST
  DAMAGE
  RETURN
  MANUAL
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// ----------------------------------------------------------------------------
// Staff / auth
// ----------------------------------------------------------------------------

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(STAFF)
  active       Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockAudits   StockAudit[]
  smsCampaigns  SmsCampaign[]
  packedOrders  Order[]        @relation("PackedBy")
  orderEvents   OrderEvent[]
  auditLogs     AuditLog[]
}

// ----------------------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  position  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  sku         String? @unique
  description String? @db.Text

  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Dual pricing. Prices in KES, stored as integer cents to avoid float drift.
  retailPrice    Int
  wholesalePrice Int?

  // Minimum order quantities per tier. Retail min is auto-enforced at checkout.
  retailMinQty    Int @default(1)
  wholesaleMinQty Int @default(1)

  /// Stock for a simple product. When hasVariants is true this is ignored and
  /// availability comes from the variants instead.
  stockQty  Int     @default(0)
  featured  Boolean @default(false)
  active    Boolean @default(true)

  /// True once the product carries size variants. Kept explicit rather than
  /// inferred from variants.length so a product can be set up as a variant
  /// product before its first variant is added.
  hasVariants Boolean @default(false)

  /// Colour variations are separate listings that know they're related.
  ///
  /// Each colour is its own Product — its own page, its own URL, its own photos
  /// and its own SEO — but siblings share a groupId so the storefront can offer
  /// the colour switcher and so wholesale quantities combine across them.
  groupId       String?
  /// The colour THIS listing represents, e.g. "White".
  colourName    String?
  colourHex     String?
  swatchMediaId String?
  /// Order of the colour chips within a group.
  groupPosition Int     @default(0)

  /// Optional urgency badge on the shop listing — the shop writes the text
  /// ("Few pieces remaining", "Selling fast"). Exact stock numbers are never
  /// shown publicly; the storefront only ever says in stock or out of stock.
  badgeText   String?
  badgeActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  promotions Promotion[]
  orderItems OrderItem[]
  stockMoves StockMovement[]
  auditItems StockAuditItem[]

  @@index([categoryId])
  @@index([featured])
  @@index([groupId])
}

/// A specific buyable combination — "White / 8*10cm".
///
/// Colours and sizes are stored per variant rather than as two independent
/// lists, because the size range genuinely differs by colour: White might come
/// in three sizes where Chocolate comes in two. Deriving the size list from the
/// variants that exist for the selected colour is what makes that work.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Either may be null — a product can vary by colour only, or size only.
  colour    String?
  size      String?

  /// Swatch presentation: a hex value, or an uploaded image for patterned or
  /// "customised" options that no single colour represents.
  colourHex     String?
  swatchMediaId String?

  sku       String? @unique
  /// Own URL for SEO, e.g. /product/poly-mailers/white-8x10. Lands on the
  /// product page with this variant preselected.
  slug      String? @unique

  retailPrice    Int
  wholesalePrice Int?

  /// Stock is held per variant so a customer only ever sees what can actually
  /// be sold, and one colour selling out doesn't hide the others.
  stockQty  Int     @default(0)
  active    Boolean @default(true)
  position  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  orderItems OrderItem[]

  @@unique([productId, colour, size])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// When set, this photo belongs to one variant — selecting that colour on
  /// the storefront swaps the gallery to its own images.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // Either an external URL, or /api/media/<mediaId> for an uploaded file.
  url       String
  mediaId   String?
  alt       String?
  position  Int     @default(0)

  @@index([productId])
  @@index([variantId])
}

/// Uploaded binaries live in Postgres so the platform needs no object store —
/// Railway containers have an ephemeral filesystem, so writing to disk would
/// lose every product photo on the next deploy.
model MediaAsset {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  bytes     Bytes
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// Promotions — per product or category-wide, time-boxed
// ----------------------------------------------------------------------------

model Promotion {
  id         String    @id @default(cuid())
  name       String
  type       PromoType
  value      Int // percent (0-100) OR cents, depending on type
  tier       PricingTier? // null = applies to both tiers
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String? // category-wide promo (resolved at pricing time)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([productId])
  @@index([categoryId])
  @@index([active])
}

// ----------------------------------------------------------------------------
// Customers (CRM — marketing + reorder)
// ----------------------------------------------------------------------------

model Customer {
  id                String   @id @default(cuid())
  phone             String   @unique // primary identity (2547XXXXXXXX)
  name              String?
  email             String?
  passwordHash      String? // set once they create a login
  marketingConsent  Boolean  @default(true)
  tags              String[] // segmentation for SMS campaigns
  notes             String?  @db.Text

  // denormalised CRM rollups (kept fresh on order completion)
  orderCount        Int      @default(0)
  totalSpent        Int      @default(0) // cents
  lastOrderAt       DateTime?

  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orders            Order[]
  addresses         Address[]
  smsMessages       SmsMessage[]

  @@index([lastOrderAt])
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String? // "Home", "Shop"
  line1      String
  line2      String?
  town       String?
  county     String?
  isDefault  Boolean  @default(false)

  @@index([customerId])
}

// ----------------------------------------------------------------------------
// Delivery methods — admin-configurable, POD toggle per method
// ----------------------------------------------------------------------------

model DeliveryMethod {
  id          String       @id @default(cuid())
  name        String
  type        DeliveryType
  description String?
  baseCost    Int          @default(0) // cents; admin sets independently
  podAllowed  Boolean      @default(false) // the enable/disable toggle
  active      Boolean      @default(true)
  position    Int          @default(0)
  config      Json? // method-specific (e.g. mtaani agent list, matatu sacco)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders      Order[]
  zones       DeliveryZone[]
}

/// A priced area within a delivery method — "Nairobi CBD", "Westlands",
/// "Upcountry". Real delivery is never one flat fee: riding to Kilimani and
/// couriering to Kisumu cost very different amounts, and a single baseCost
/// forced the shop to either lose money on far orders or overcharge near ones.
///
/// Store pickup never has zones (the customer comes to you), which the API
/// enforces rather than leaving to the UI.
model DeliveryZone {
  id          String         @id @default(cuid())
  methodId    String
  method      DeliveryMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Cents. Replaces the method's baseCost when this zone is chosen.
  price       Int            @default(0)
  /// Optional free-delivery threshold for this zone only, in cents.
  freeAbove   Int?
  active      Boolean        @default(true)
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  orders      Order[]

  @@index([methodId])
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  /// Set by the storefront per checkout attempt. A repeated submit with the
  /// same key returns the existing order rather than creating a duplicate —
  /// which is what a page refresh or a double-tap on "Pay" used to do.
  idempotencyKey String?  @unique // human-facing, e.g. ENZ-2026-000123

  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])

  tier        PricingTier @default(RETAIL)
  status      OrderStatus @default(DRAFT)

  // money, all cents
  subtotal    Int         @default(0)
  deliveryFee Int         @default(0)
  discount    Int         @default(0)
  total       Int         @default(0)

  // delivery snapshot
  deliveryMethodId String?
  deliveryMethod   DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id])
  deliveryZoneId   String?
  deliveryZone     DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  isPayOnDelivery  Boolean         @default(false)
  deliveryDetails  Json? // snapshot address / agent / matatu details

  isPaid      Boolean     @default(false)
  paidAt      DateTime?

  // Fulfilment — who did what, when. Drives the shop-floor packing queue.
  packedAt      DateTime?
  packedById    String?
  packedBy      StaffUser? @relation("PackedBy", fields: [packedById], references: [id])
  dispatchedAt  DateTime?
  deliveredAt   DateTime?
  trackingRef   String?     // waybill / matatu parcel no. / Mtaani agent code
  staffNotes    String?     @db.Text

  /// Refunds need a second pair of eyes: whoever asks can't be the one who
  /// approves. If the requester is an ADMIN, only a SUPERADMIN can sign it off.
  refundRequestedById String?
  refundRequestedAt   DateTime?
  refundReason        String?
  refundApprovedById  String?
  refundApprovedAt    DateTime?

  returnedAt    DateTime?

  placedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
  payments    Payment[]
  events      OrderEvent[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  // snapshots (price/name frozen at time of order)
  name       String
  /// "White / 8*10cm" — frozen so a later rename doesn't rewrite history.
  variantLabel String?
  unitPrice  Int // effective price after tier + promo, cents
  quantity   Int
  lineTotal  Int
  tier       PricingTier @default(RETAIL)

  @@index([orderId])
  @@index([productId])
}

/// Who changed what, so a supervisor can answer "who did this?" without
/// guessing. Deliberately append-only and never edited: an audit trail you can
/// rewrite is not an audit trail.
model AuditLog {
  id         String     @id @default(cuid())
  staffId    String?
  staff      StaffUser? @relation(fields: [staffId], references: [id])
  /// Snapshot of who did it, so the entry still reads correctly after an
  /// account is renamed or removed.
  staffName  String?
  staffRole  String?
  /// "promotion.create", "settings.update", "order.refund" …
  action     String
  entity     String?
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([staffId])
  @@index([action])
}

/// Append-only fulfilment history, so you can always answer "who marked this
/// packed, and when?" without trusting a single mutable status column.
model OrderEvent {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     StaffUser? @relation(fields: [staffId], references: [id])
  fromStatus String?
  toStatus   String?
  note      String?
  createdAt DateTime   @default(now())

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// Payments
// ----------------------------------------------------------------------------

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider @default(MPESA)
  status            PaymentStatus   @default(PENDING)
  amount            Int // cents
  phone             String?

  // Daraja STK fields
  checkoutRequestId String?         @unique
  merchantRequestId String?
  mpesaReceipt      String?
  resultCode        Int?
  resultDesc        String?
  rawCallback       Json?

  /// Provider-agnostic identifiers, so a second gateway doesn't have to
  /// masquerade as Daraja. Kopo Kopo's incoming-payment id lands in
  /// providerRef; whatever reference the customer sees on their phone
  /// (M-Pesa code, Kopo Kopo receipt) lands in receiptRef.
  providerRef       String?         @unique
  receiptRef        String?
  /// Kopo Kopo resource URL for this payment, so we can query its status
  /// directly instead of only waiting for a webhook.
  statusUrl         String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Stock — movement ledger + audit sessions
// ----------------------------------------------------------------------------

model StockMovement {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int // +restock / -sale
  reason    StockReason
  refId     String? // order id, audit id, etc.
  note      String?
  createdAt DateTime    @default(now())

  @@index([productId])
  @@index([createdAt])
}

model StockAudit {
  id        String           @id @default(cuid())
  reference String           @unique
  staffId   String?
  staff     StaffUser?       @relation(fields: [staffId], references: [id])
  note      String?
  closedAt  DateTime?
  createdAt DateTime         @default(now())

  items     StockAuditItem[]
}

model StockAuditItem {
  id           String     @id @default(cuid())
  auditId      String
  audit        StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  systemQty    Int // qty per system at count time
  countedQty   Int // physical count
  variance     Int // counted - system
  applied      Boolean    @default(false) // adjustment posted to ledger?

  @@index([auditId])
}

// ----------------------------------------------------------------------------
// SMS marketing (Africa's Talking)
// ----------------------------------------------------------------------------

model SmsCampaign {
  id         String         @id @default(cuid())
  name       String
  body       String         @db.Text
  segment    Json? // filter used to pick recipients (tags, lastOrder window…)
  status     CampaignStatus @default(DRAFT)
  staffId    String?
  staff      StaffUser?     @relation(fields: [staffId], references: [id])
  recipients Int            @default(0)
  costCents  Int            @default(0)
  sentAt     DateTime?
  createdAt  DateTime       @default(now())

  messages   SmsMessage[]
}

model SmsMessage {
  id         String      @id @default(cuid())
  campaignId String?
  campaign   SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  phone      String
  body       String      @db.Text
  status     SmsStatus   @default(QUEUED)
  providerId String? // AT messageId
  costCents  Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([campaignId])
  @@index([customerId])
}

// ----------------------------------------------------------------------------
// Content: reviews, blog, FAQ
// ----------------------------------------------------------------------------

model Review {
  id        String   @id @default(cuid())
  authorName String
  rating    Int // 1-5
  body      String   @db.Text
  verified  Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String    @db.Text
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Settings — business config the admin controls (non-secret)
// ----------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  /// Secrets (API keys, passkeys) are never returned in full to the browser —
  /// the settings endpoint masks them to a last-4 preview.
  secret    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
