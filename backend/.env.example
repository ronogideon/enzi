# --- core ---
DATABASE_URL="postgresql://user:pass@host:5432/enzi"
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Leave BLANK to allow any origin — which is safe here because auth is a Bearer
# token in a header, not a cookie. Setting it wrong is the #1 cause of the
# admin dashboard showing "Failed to fetch", so if in doubt, leave it empty.
# localhost and *.railway.app are always allowed regardless.
CORS_ORIGINS=""

# --- auth ---
JWT_SECRET="change-me-in-railway"
JWT_EXPIRES_IN="7d"

# --- first admin account (used by `npm run seed`) ---
ADMIN_EMAIL="admin@enzipackaging.co.ke"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Enzi Admin"

# --- M-Pesa Daraja (STK push) ---
# These are now FALLBACKS ONLY. Once you save M-Pesa credentials in the admin
# dashboard (Settings -> Payments) the database values win, and you can change
# keys without a redeploy. Leave these blank if you'd rather manage them in the UI.
MPESA_ENV="sandbox"                 # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                  # paybill/till
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://your-backend.up.railway.app/api/payments/mpesa/callback"

# --- Africa's Talking (SMS) --- also overridable from Settings -> SMS
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID="ENZI"

# --- store defaults ---
STORE_NAME="Enzi Packaging"
ORDER_PREFIX="ENZ"
