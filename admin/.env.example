# Where the admin dashboard finds the API.
#
# In production, set API_URL (not VITE_API_URL) as a Railway variable on the
# admin service — gen-env.mjs writes it into dist/env.js at container start, so
# one build works in any environment with no rebuild.
#
# The trailing "/api" is added automatically if you leave it off, so both of
# these are correct:
#   API_URL="https://enzi-backend.up.railway.app"
#   API_URL="https://enzi-backend.up.railway.app/api"
#
# VITE_API_URL below is only a build-time fallback for local development.
VITE_API_URL="http://localhost:4000/api"
