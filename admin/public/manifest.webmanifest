{
  "name": "Enzi Admin",
  "short_name": "Enzi Admin",
  "description": "Orders, stock and products for Enzi Packaging staff.",
  "id": "/",
  "start_url": "/orders",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0A0B",
  "theme_color": "#0A0A0B",
