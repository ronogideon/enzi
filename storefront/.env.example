# Backend API address.
#
# Read at RUNTIME (server start), not compiled into the build — so changing this
# in Railway and restarting is enough. No rebuild needed.
#
# Use the full URL including https://. A bare hostname is not an absolute URL,
# so the browser would treat it as a relative path and send every API call back
# to the storefront itself. The code adds a missing scheme defensively, but be
# explicit. Do NOT use Railway's ${{service.RAILWAY_PUBLIC_DOMAIN}} reference
# here — it resolves to a bare host with no scheme.
#
# The trailing /api is added automatically.
API_URL="https://api.enzipackaging.com"

# WhatsApp number for the floating chat / contact CTA (no +). Also runtime.
WHATSAPP="254110050620"

# Legacy build-time equivalents. Still honoured as a fallback for local dev,
# but API_URL above is preferred everywhere.
# NEXT_PUBLIC_API_URL="http://localhost:4000"
# NEXT_PUBLIC_WHATSAPP="254110050620"
